# Where PostgreSQL runs. As written: the postgres container. For a PostgreSQL installed on this
# machine, run scripts/use-local-postgres.sh once, then set POSTGRES_HOST=host.docker.internal
# and leave COMPOSE_PROFILES empty.
POSTGRES_HOST=postgres
COMPOSE_PROFILES=container-db
