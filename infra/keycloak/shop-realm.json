{
  "realm": "shop",
  "enabled": true,
  "sslRequired": "none",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "clients": [
    {
      "clientId": "shop-cli",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false
    },
    {
      "clientId": "shop-web",
      "name": "MyShoppingCart storefront",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/"
      ],
      "webOrigins": [
        "http://localhost:8000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8000/"
      }
    }
  ],
  "users": [
    {
      "id": "a11ce000-0000-4000-8000-000000000001",
      "username": "${SHOP_USER}",
      "enabled": true,
      "emailVerified": true,
      "email": "${SHOP_USER}@example.com",
      "firstName": "Test",
      "lastName": "Shopper",
      "credentials": [
        {
          "type": "password",
          "value": "${SHOP_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "ad000000-0000-4000-8000-000000000002",
      "username": "${SHOP_ADMIN}",
      "enabled": true,
      "emailVerified": true,
      "email": "${SHOP_ADMIN}@example.com",
      "firstName": "Test",
      "lastName": "Admin",
      "realmRoles": [
        "admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${SHOP_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Can restock products"
      }
    ]
  }
}
