{
  "realm": "shop",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "shop-cli",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false
    }
  ],
  "users": [
    {
      "username": "${SHOP_USER}",
      "enabled": true,
      "emailVerified": true,
      "email": "${SHOP_USER}@example.com",
      "firstName": "Test",
      "lastName": "Shopper",
      "credentials": [
        {
          "type": "password",
          "value": "${SHOP_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "${SHOP_ADMIN}",
      "enabled": true,
      "emailVerified": true,
      "email": "${SHOP_ADMIN}@example.com",
      "firstName": "Test",
      "lastName": "Admin",
      "realmRoles": [
        "admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${SHOP_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Can restock products"
      }
    ]
  }
}
